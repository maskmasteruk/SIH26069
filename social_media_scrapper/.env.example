# ============================================================
# HASHTAG MONITOR CONFIGURATION
# ============================================================

# Search interval
SEARCH_INTERVAL_MINUTES=5

# Results requested from each platform for each hashtag
MAX_RESULTS_PER_HASHTAG=25000

# Number of hashtags to search from the top of hashtags.txt
# Use 0 to search all hashtags, or 1, 2, 3, ...
HASHTAGS_TO_SEARCH=0

# Enable/disable platforms
ENABLE_YOUTUBE=true
ENABLE_REDDIT=true
ENABLE_BLUESKY=false
ENABLE_MASTODON=true


# ============================================================
# YOUTUBE
# ============================================================

YOUTUBE_API_KEY=YOUR_YOUTUBE_API_KEY


# ============================================================
# REDDIT
# ============================================================

REDDIT_CLIENT_ID=YOUR_REDDIT_CLIENT_ID
REDDIT_CLIENT_SECRET=YOUR_REDDIT_CLIENT_SECRET

# Change this to identify your application
REDDIT_USER_AGENT=hashtag-monitor/1.0


# ============================================================
# BLUESKY
# ============================================================

# No API key needed for public search
BLUESKY_API_BASE=https://public.api.bsky.app


# ============================================================
# MASTODON
# ============================================================

# You can change this to another Mastodon instance
MASTODON_BASE_URL=https://mastodon.social


# ============================================================
# KAFKA EVENT STREAM
# ============================================================

# Publishes one event when a new post is saved
ENABLE_KAFKA_EVENT_STREAM=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=social_media_new_posts
KAFKA_CLIENT_ID=hashtag-monitor

# Use PLAINTEXT, SSL, SASL_PLAINTEXT, or SASL_SSL
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_SEND_TIMEOUT_SECONDS=10


# ============================================================
# DATABASE / OUTPUT
# ============================================================

DATABASE_FILE=social_media.db
JSON_OUTPUT=social_media_results.json
CSV_OUTPUT=social_media_results.csv

REQUEST_TIMEOUT=30

# Delay between API requests
REQUEST_DELAY_SECONDS=1
