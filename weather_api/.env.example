# ============================================================
# WEATHER SERVICE CONFIGURATION
# ============================================================

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_INPUT_TOPIC=location_data
KAFKA_OUTPUT_TOPIC=weather_data
KAFKA_GROUP_ID=weather_service


# ============================================================
# OPEN-METEO WEATHER API
# ============================================================

WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
WEATHER_API_TIMEOUT_SECONDS=15
WEATHER_TIMEZONE=auto

# Comma-separated Open-Meteo current weather variables
WEATHER_CURRENT_FIELDS=temperature_2m,relative_humidity_2m,apparent_temperature,precipitation,rain,weather_code,cloud_cover,wind_speed_10m,wind_direction_10m,wind_gusts_10m,pressure_msl


# ============================================================
# DATABASE / OUTPUT
# ============================================================

DATABASE_FILE=weather_api.db
