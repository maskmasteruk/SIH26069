# ============================================================
# KAFKA EVENT LISTENER
# ============================================================

KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# News scraper topic: india_weather_news
# Social media scraper topic: social_media_new_posts
KAFKA_TOPIC=india_weather_news
KAFKA_GROUP_ID=event-listener

# Use PLAINTEXT, SSL, SASL_PLAINTEXT, or SASL_SSL.
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_USERNAME=
KAFKA_PASSWORD=


# ============================================================
# POSTGRESQL
# Matches postgres/docker-compose.yml for local Docker.
# ============================================================

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=disaster_events
POSTGRES_USER=disaster_admin
POSTGRES_PASSWORD=disaster_password

# Alternatively, define DATABASE_URL instead of POSTGRES_*:
# DATABASE_URL=postgresql+psycopg://disaster_admin:disaster_password@localhost:5432/disaster_events


# ============================================================
# MODEL AND MATCHING
# ============================================================

MODEL_NAME=xlm-roberta-base
SIMILARITY_THRESHOLD=0.78
ASSUMED_EVENT_THRESHOLD=5
MATCHING_TIME_WINDOW_HOURS=72
MATCHING_CANDIDATE_LIMIT=100
