# Uses the PostgreSQL service from ../postgres/docker-compose.yml
DATABASE_URL=postgres://disaster_admin:disaster_password@localhost:5432/disaster_events

# Web UI port for admin user management.
ADMIN_USERS_PORT=3100

# Replace for non-local use.
ADMIN_USERS_SESSION_SECRET=replace-with-a-long-random-secret
ADMIN_USERS_SESSION_HOURS=8

# Roles that can sign in to this manager.
ADMIN_MANAGER_ROLES=admin,super_admin

# Roles available in the create/edit forms.
ADMIN_ALLOWED_ROLES=admin,super_admin,viewer

# Creates a fallback account only when no matching username exists.
# The SQL seed already creates admin/admin for local Docker.
ADMIN_USERS_BOOTSTRAP_ENABLED=true
ADMIN_USERS_BOOTSTRAP_USERNAME=admin
ADMIN_USERS_BOOTSTRAP_EMAIL=admin@wave.local
ADMIN_USERS_BOOTSTRAP_PASSWORD=admin
ADMIN_USERS_BOOTSTRAP_ROLE=admin
