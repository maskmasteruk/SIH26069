# ============================================================
# WEATHER NEWS SCRAPER CONFIGURATION
# ============================================================

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=india_weather_news

SCRAPE_INTERVAL_SECONDS=600
REQUEST_TIMEOUT=15
MAX_ARTICLES_PER_SOURCE=30
SOURCE_DELAY_SECONDS=2

USER_AGENT="Mozilla/5.0 (compatible; WeatherNewsMonitor/1.0; +https://example.com/weather-monitor)"


# ============================================================
# KAFKA PRODUCER
# ============================================================

KAFKA_ACKS=all
KAFKA_COMPRESSION_TYPE=snappy
KAFKA_LINGER_MS=100
KAFKA_RETRIES=5
KAFKA_ENABLE_IDEMPOTENCE=true


# ============================================================
# DATABASE / OUTPUT
# ============================================================

DATABASE_FILE=news_scrapper.db


# ============================================================
# OPTIONAL DATA OVERRIDES
# ============================================================

# Leave empty to use the default sources defined in main.py.
# Expected format: JSON array of source objects with name, url, region, language, and type.
NEWS_SOURCES_JSON=

# Leave empty to use the default keyword list defined in weather_filter.py.
# Use comma-separated values when overriding.
WEATHER_KEYWORDS=

# Number of matched weather keywords required before an item is considered weather-related.
MIN_WEATHER_KEYWORD_MATCHES=2

# Leave empty to use the default India location list defined in main.py.
# Use comma-separated values when overriding.
INDIAN_LOCATIONS=
